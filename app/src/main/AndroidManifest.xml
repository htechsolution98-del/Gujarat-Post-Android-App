<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for REST API & image downloading -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".GujaratPostApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GujaratPost"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Animated Brand Splash Launcher Activity -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:theme="@style/Theme.GujaratPost.Splash"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Home & Portal Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:theme="@style/Theme.GujaratPost"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
        </activity>

        <!-- Full Article Detail Activity with Deep Link Support -->
        <activity
            android:name=".ui.detail.ArticleDetailActivity"
            android:exported="true"
            android:parentActivityName=".ui.MainActivity"
            android:screenOrientation="portrait">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="gujaratpost.in"
                    android:pathPrefix="/news" />
                <data
                    android:scheme="https"
                    android:host="gujaratpost.vercel.app"
                    android:pathPrefix="/news" />
            </intent-filter>
        </activity>

    </application>

</manifest>
