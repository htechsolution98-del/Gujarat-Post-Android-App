<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Center Brand Content Wrapper for Animation -->
    <LinearLayout
        android:id="@+id/layout_splash_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/progress_splash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Glowing White Logo Container Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_splash_logo"
            android:layout_width="250dp"
            android:layout_height="78dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/iv_splash_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/gujarat_post_logo" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Official Gujarati Tagline -->
        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="સત્ય અને સચોટ સમાચાર"
            android:textColor="@color/white"
            android:textSize="16.5sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Discreet Bottom Loading Indicator -->
    <ProgressBar
        android:id="@+id/progress_splash"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="20dp"
        android:indeterminateTint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/tv_splash_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Editorial Footer Tag -->
    <TextView
        android:id="@+id/tv_splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.06"
        android:text="ગુજરાત પોસ્ટ • ડિજિટલ સમાચાર પોર્ટલ"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
