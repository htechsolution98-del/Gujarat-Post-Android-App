<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_breaking_news"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFF1F2"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="#FDA4AF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="9dp">

        <!-- Red Rounded Pill Badge with Beacon & Gujarati Label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_breaking_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4.5dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_live_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"
                android:text="બ્રેકિંગ ન્યૂઝ"
                android:textColor="@color/white"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_breaking_news_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Counter e.g. 1 / 5 -->
        <TextView
            android:id="@+id/tv_breaking_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_breaking_counter"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#991B1B"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
